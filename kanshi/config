profile vb2 {
    # primary
    output "HDMI-A-1" mode 3840x2160@60Hz position     0,0
    # secondary
    output "DP-1"     mode 3840x2160@60Hz position  2742,0
    # laptop
    output "eDP-1"    mode 1920x1080@60Hz position -1920,0

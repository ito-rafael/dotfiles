# Outputs:
#
#   +-----------+ +-----------+ +--------+
#   |           | |           | |        |=++
#   | secondary | |  primary  | | terti..| ||
#   |           | |           | |  ..ary | ||
#   +-----------+ +-----------+ |        | ||
#   +---/   \--+  +--/   \---+  |        | ||
#   |----------|  |----------|  +--------+ ||
# --+----------+--+----------+-------------++--
#
#
profile {
    # left monitor: AOC 1 (secondary) [DP-1]
    output "AOC 2369M 23039IA002716" mode 1920x1080@60Hz position 0,0
    # middle monitor: Dell Primary (primary) [HDMI-A-1]
    output "Dell Inc. DELL SE2416H Y4GVX82704FL" mode 1920x1080@60Hz position 1920,0
    # right monitor: AOC 2 - Vertical (tertiary) [DVI-I-1]
    output "AOC 2369M 23039IA002615" mode 1920x1080@60Hz position 3840,0 transform 90
}

output "Chimei Innolux Corporation 0x143F Unknown" {
  mode 1920x1200@60.003
  position 0,0
  scale 1
  transform normal
  alias $IPF
}

profile ipf_extend_hdmi {
    output $IPF enable
    output "HDMI-A-1" mode 3840x2160@60Hz position 1920,0 scale 2
}

profile ipf_extend_dp {
    output $IPF enable
    output "DP-1" mode 3840x2160@60Hz position 1920,0 scale 2
}

profile ipf_mirror_hdmi {
    output $IPF enable
    output "HDMI-A-1" mode 3840x2160@60Hz position 0,0 scale 2
}

profile ipf_mirror_dp {
    output $IPF enable
    output "DP-1"  mode 3840x2160@60Hz position 0,0 scale 2
}

profile ipf_native {
    output $IPF enable
}

# Outputs:
#
#   +-------+ +-------+
#   |   2   | |   1   |
#   +-------+ +-------+
#              +-----+
#              |  3  |
#              +-----+
#
#   1: Samsung UR55
#   2: Samsung UR55
#   3: VB laptop
#
profile vb1 {
    # primary
    output "HDMI-A-1" mode 3840x2160@60Hz position      0,0
    # secondary
    output "DP-1"     mode 3840x2160@60Hz position  -2742,0
    # laptop
    output "eDP-1"    mode 1920x1080@60Hz position 411,1542
}

# Outputs:

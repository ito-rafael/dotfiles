            }
          ],
          "CustomName": "",
          "CustomSettings": {
            "audio_settings": {
              "amplitude": 100,
              "audio_device": -1,
              "avg_mode": 0,
              "avg_size": 8,
              "decay": 80,
              "equalizer": [
                1.0,

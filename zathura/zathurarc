set recolor true
map <M-d> recolor
map [presentation] <M-d> recolor
map [fullscreen] <M-d> recolor

set selection-clipboard clipboard

map [normal] n scroll left
map [normal] e scroll down
map [normal] i scroll up
map [normal] o scroll right

map [normal] E navigate next
map [normal] I navigate previous

map [normal] d scroll full-down
map [normal] u scroll full-up

map [normal] <C-e> scroll half-down
map [normal] <C-i> scroll half-up

map [normal] a adjust_window best-fit
map [normal] s adjust_window width
map [normal] D toggle_page_mode
map [normal] c toggle_single_page_mode

map [normal] p toggle_presentation
map [presentation] p toggle_presentation

map [presentation] n navigate previous
map [presentation] i navigate previous
map [presentation] u navigate previous
map [presentation] e navigate next
map [presentation] o navigate next
map [presentation] d navigate next

map [presentation] gg goto top
map [presentation] G goto bottom

map [normal] k search forward
map [normal] K search backward
map [presentation] k search forward
map [presentation] K search backward

map [normal] <C-+> zoom in
map [normal] <C--> zoom out
map [normal] = zoom 0

map [normal] <Tab> toggle_index

map [normal] f follow
